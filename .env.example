# Application
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=1
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173"]
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# SQLite: configure only the database file path
DATABASE_PATH=./data/sayra.db
DATABASE_ECHO=false
DATABASE_BUSY_TIMEOUT_MS=5000

# File storage
# local: STORAGE_ROOT_PATH/file_path
# minio: STORAGE_BUCKET/STORAGE_ROOT_PATH/file_path
STORAGE_TYPE=local
STORAGE_BUCKET=sayra
STORAGE_ROOT_PATH=./data/files
STORAGE_STREAM_CHUNK_BYTES=65536
STARTUP_CHECK_STORAGE=true
RETRY_FAILED_DELETIONS_ON_STARTUP=true

# Only required when STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_REGION=

# OpenAI-compatible LLM
LLM_PROVIDER_NAME=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Volcengine ASR/TTS
ASR_PROVIDER_NAME=volcengine
TTS_PROVIDER_NAME=volcengine
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_ASR_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
VOLCENGINE_TTS_URL=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TIMEOUT_SECONDS=30
VOLCENGINE_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
VOLCENGINE_ASR_LANGUAGE_MAP={"zh-CN":"zh-CN","zh-TW":"zh-TW","en":"en-US","ja":"ja-JP","ko":"ko-KR","fr":"fr-FR","de":"de-DE","es":"es-ES"}
TTS_SPEED_BY_DIFFICULTY={"A1":0.92,"A2":0.95,"B1":0.98,"B2":1.0,"C1":1.02,"C2":1.04}

# Conversation/runtime
DEFAULT_VOICE_ID=
DEFAULT_SUGGESTION_COUNT=1
MAX_SUGGESTION_COUNT=5
MAX_UPLOAD_BYTES=26214400
AUDIO_CONVERSION_TIMEOUT_SECONDS=30
CONTEXT_RECENT_TURNS=10
CONTEXT_SUMMARY_TRIGGER_TURNS=14
TTS_SENTENCE_MIN_CHARS=12
TTS_SENTENCE_MAX_CHARS=180
LIVE_EVENT_BUFFER_SIZE=512
EVENT_REPLAY_BATCH_SIZE=200
LIVE_AUDIO_EVENT_RETENTION_SECONDS=60
TASK_SHUTDOWN_GRACE_SECONDS=15
# Optional directory override; files must match PROMPT_FILES in common/config.py.
# PROMPT_ROOT=/etc/sayra/prompts

# Logging
LOG_ROOT=./log
LOG_LEVEL=INFO
LOG_FILE_ENCODING=utf-8
LOG_FILE_OUTPUT=true
